flowchart LR
    R1["request 1"] --> Q[("audit_request<br/>= the queue")]
    R2["request 2"] --> Q
    RN["request N"] --> Q
    Q -->|"FOR UPDATE SKIP LOCKED<br/>one at a time"| W["single worker"]
    W -->|"reads the workload figure<br/>with no competition"| P["place: earliest free date,<br/>least-loaded auditor"]
    P --> C{"UNIQUE auditor_id + audit_date"}
    C -->|ok| D["audit_request SCHEDULED"]
    C -->|"lost the race"| P
